# Build output (bin/Blockfall.exe is committed on purpose so the game can be downloaded ready to run)
build/
build-win/
build-linux/
build-tests/
out/
dist/
shots*/
*.bmp
__pycache__/
*.obj
*.o

# Secrets: real values live in .env, never committed (.env.example lists the names)
.env
.env.*
!.env.example

# Python tools
.venv/

# Node (if ever used)
node_modules/

# Editors (Visual Studio "Open Folder" and VS Code local state)
.vs/
.vscode/

# Payment server: local test database and Python caches
server/payments/*.db
.pytest_cache/
