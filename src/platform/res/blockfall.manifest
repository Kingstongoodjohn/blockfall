<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Tells Windows what Blockfall is: a normal app that runs without admin rights on Windows 10/11.
     Programs without a manifest or version details look more suspicious to antivirus heuristics. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Blockfall.Game" version="14.0.0.0" processorArchitecture="amd64"/>
  <description>Blockfall - a build-and-shoot battle royale game</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
