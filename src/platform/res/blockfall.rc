// Blockfall - Windows resources: icon, version details and the app manifest.
// Antivirus tools and SmartScreen treat an unknown .exe with no publisher, version or description
// as more suspicious, so the game says what it is. (Only code signing removes the warnings fully.)
#include <winver.h>

#define BF_VERSION     14,0,0,0
#define BF_VERSION_STR "14.0.0.0"

1 ICON "blockfall.ico"
1 24 "blockfall.manifest"   // 24 = RT_MANIFEST, 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID

VS_VERSION_INFO VERSIONINFO
FILEVERSION     BF_VERSION
PRODUCTVERSION  BF_VERSION
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Blockfall"
            VALUE "FileDescription",  "Blockfall - build-and-shoot battle royale game"
            VALUE "FileVersion",      BF_VERSION_STR
            VALUE "InternalName",     "Blockfall"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Blockfall"
            VALUE "OriginalFilename", "Blockfall.exe"
            VALUE "ProductName",      "Blockfall"
            VALUE "ProductVersion",   BF_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
